<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Ambo Speciale di Ottobre</title>
<style>
  *{box-sizing:border-box}
  body{margin:0;background:#0a0a12;color:#e4e4ee;font-family:Calibri,Segoe UI,Roboto,sans-serif;
       padding:env(safe-area-inset-top) 12px 30px}
  h1{color:#d4af5a;font-size:21px;margin:14px 0 4px}
  h2{color:#ffd369;font-size:17px;margin:22px 0 8px}
  .sub{font-size:12.5px;color:#c9c9d8;margin:2px 0}
  #status{font-size:12.5px;color:#f0cd82;font-weight:bold;margin:6px 0 10px}
  .card{background:#161622;border:1px solid #2a2a40;border-radius:10px;padding:12px;margin:8px 0}
  .tit{color:#d4af5a;font-weight:bold;font-size:14px}
  .wait{color:#c8be8c}
  .num{font-size:26px;font-weight:bold;color:#f0cd82;margin:8px 0;font-family:Consolas,monospace}
  .info{font-size:12.5px;color:#f5f5fa;margin:4px 0}
  .ok{color:#00e676;font-weight:bold}
  .go{color:#38bdf8;font-weight:bold}
  .ko{color:#ff707d;font-weight:bold}
  .btns{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}
  button{flex:1;min-width:140px;padding:12px;border-radius:8px;background:#18182a;color:#fff;
         border:1px solid #5aa0dc;font-weight:bold;font-size:14px}
  button:active{background:#2a2a3e}
  .riga{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
  .anno{color:#ffd369;font-weight:bold;font-size:16px}
  .amb{font-family:Consolas,monospace;font-weight:bold;font-size:16px}
  .meta{font-size:12px;color:#82b1ff;margin:3px 0 6px}
  .esiti div{font-size:13px;margin:2px 0}
  .tot{background:#0a0b10;border-color:#ffd369;color:#00e676;font-weight:bold;font-size:13px;line-height:1.6}
  #toast{position:fixed;left:12px;right:12px;bottom:14px;background:#222238;border:1px solid #d4af5a;
         padding:12px;border-radius:8px;display:none;font-size:14px;white-space:pre-line}
</style>
</head>
<body>
<h1>🍂 AMBO SPECIALE DI OTTOBRE</h1>
<p class="sub">1 Ambo secco su GENOVA-MILANO • 13 estrazioni • All'ultima estrazione di Settembre • Recupero: TUTTE e NAZIONALE</p>
<p class="sub">www.mauriziocarini.it</p>
<div id="status">Archivio non caricato – premi Aggiorna Internet</div>

<div id="prev" class="card"></div>

<div class="btns">
  <button id="bAgg">⬇ Aggiorna Internet</button>
  <button id="bCalc">🔢 Ricalcola</button>
</div>

<h2>📊 Esiti storici</h2>
<div id="storico"></div>
<div id="toast"></div>

<script>
const URL_GITHUB = "https://raw.githubusercontent.com/carinimaurizio2-code/archivio-lotto/main/storico.txt";
const COLPI = 13, ANNO_INIZIO = 2014;
const $ = id => document.getElementById(id);

let archivio = [], byDate = new Map(), dates = [];

/* ---------- utilità ---------- */
function toast(msg){ const t=$("toast"); t.textContent=msg; t.style.display="block"; clearTimeout(toast.h); toast.h=setTimeout(()=>t.style.display="none",5000); }

const NORM = {RO:"RM",BARI:"BA",CAGLIARI:"CA",FIRENZE:"FI",GENOVA:"GE",MILANO:"MI",NAPOLI:"NA",
              PALERMO:"PA",ROMA:"RM",TORINO:"TO",VENEZIA:"VE",NAZIONALE:"RN"};
const norm = c => { c=c.toUpperCase(); return NORM[c]||c; };

function parse(testo){
  const out=[];
  for(const riga of testo.split(/\r?\n/)){
    const c=riga.trim().split(/[\t ]+/);
    if(c.length<7 || !/^\d{4}\/\d{2}\/\d{2}$/.test(c[0])) continue;
    const n=c.slice(2,7).map(Number);
    if(n.some(x=>!Number.isInteger(x)||x<1||x>90)) continue;
    out.push({d:c[0], r:norm(c[1]), n});
  }
  return out;
}

function indicizza(){
  byDate=new Map();
  for(const e of archivio){ if(!byDate.has(e.d)) byDate.set(e.d,[]); byDate.get(e.d).push(e); }
  dates=[...byDate.keys()].sort();
  $("status").textContent = dates.length
    ? `Archivio: ${archivio.length} estrazioni — Ultima: ${dates[dates.length-1]}`
    : "Archivio non caricato – premi Aggiorna Internet";
}

/* ---------- matematica del metodo ---------- */
const fuori90 = n => { let v=n%90; if(v<=0) v+=90; return v; };
function figura(n){
  let s=Math.floor(n/10)+(n%10);
  while(s>9) s-=9;
  return s===0?9:s;
}

function ultimaSett(ruota, anno){
  const pre=anno+"/09";
  const ok=dates.filter(d=>d.startsWith(pre) && byDate.get(d).some(e=>e.r===ruota));
  return ok.length? ok[ok.length-1] : "";
}

function calcola(dataTarget, anno){
  const eGE = (byDate.get(dataTarget)||[]).find(e=>e.r==="GE");
  if(!eGE) return null;
  const [n1,n2,n3,n4,n5]=eGE.n;
  const fig=figura(n2);
  let a1,a2;
  if(fig===2||fig===4){ a1=fuori90(n1+6); a2=fuori90(n3+45); }
  else if(fig===1||fig===6){ a1=fuori90(n1+8); a2=fuori90(n4+10); }
  else if(fig===3||fig===9){ a1=fuori90(n1+7); a2=fuori90(n4+33); }
  else if(fig===5||fig===8){ a1=fuori90(n4+3); a2=fuori90(n5+14); }
  else return null; // figura 7 non prevista
  let t=0; while(a1===a2 && t<50){ a2=fuori90(a2+1); t++; }
  return {data:dataTarget, anno, base:n2, fig, a1, a2,
          str:String(a1).padStart(2,"0")+"-"+String(a2).padStart(2,"0"),
          esiti:[], stato:"NEGATIVO", colpoMin:0, colpiGiocati:0};
}

function verifica(res){
  const amb=[res.a1,res.a2];
  const ha = nums => amb.every(x=>nums.includes(x));
  const succ = dates.filter(d=>d>res.data).slice(0,COLPI);
  res.colpiGiocati=succ.length;
  succ.forEach((d,i)=>{
    const colpo=i+1, giorno=byDate.get(d);
    const segna=()=>{ res.stato="AMBO"; if(!res.colpoMin||colpo<res.colpoMin) res.colpoMin=colpo; };
    for(const rg of ["GE","MI"]){
      const e=giorno.find(x=>x.r===rg);
      if(e && ha(e.n)){ res.esiti.push(`✔ Ambo secco (${res.str}) su ${rg==="GE"?"GENOVA":"MILANO"} al ${colpo}° colpo`); segna(); }
    }
    for(const e of giorno){
      if(["GE","MI","RN"].includes(e.r)) continue;
      if(ha(e.n)){ res.esiti.push(`✔ Ambo su TUTTE (ruota ${e.r}) al ${colpo}° colpo`); segna(); }
    }
    const rn=giorno.find(x=>x.r==="RN");
    if(rn && ha(rn.n)){ res.esiti.push(`✔ Ambo su NAZIONALE al ${colpo}° colpo`); segna(); }
  });
}

/* ---------- previsione attiva ---------- */
function settembreConcluso(anno){
  const oggi=new Date(), Y=oggi.getFullYear(), M=oggi.getMonth()+1;
  if(anno<Y) return true;
  if(anno>Y) return false;
  if(M>9) return true;
  if(M<9) return false;
  const ds=dates.filter(d=>d.startsWith(anno+"/09"));
  if(!ds.length) return false;
  const [y,m,g]=ds[ds.length-1].split("/").map(Number);
  const dt=new Date(y,m-1,g+1), fine=new Date(anno,8,30);
  while(dt<=fine){
    if([2,4,5,6].includes(dt.getDay())) return false; // mar, gio, ven, sab
    dt.setDate(dt.getDate()+1);
  }
  return true;
}

function annoAttivo(){
  const oggi=new Date();
  let c = (oggi.getMonth()+1)>=9 ? oggi.getFullYear() : oggi.getFullYear()-1;
  for(let i=0;i<=6;i++){
    if(settembreConcluso(c) && ultimaSett("GE",c)!=="") return c;
    c--;
  }
  return 0;
}

function renderAttiva(){
  const el=$("prev");
  const oggi=new Date(), Y=oggi.getFullYear(), M=oggi.getMonth()+1;
  if(!archivio.length){ el.innerHTML='<div class="tit">Archivio non caricato – premi "Aggiorna Internet"</div>'; return; }
  if(M===9 && !settembreConcluso(Y)){
    el.innerHTML=`<div class="tit wait">⏳ Settembre ${Y} ancora in corso — la previsione sarà calcolata sull'ultima estrazione del mese, non appena disponibile.</div>`; return;
  }
  const anno=annoAttivo();
  if(!anno){ el.innerHTML='<div class="tit wait">⏳ In attesa dell\'ultima estrazione di Settembre su GENOVA...</div>'; return; }
  const res=calcola(ultimaSett("GE",anno),anno);
  if(!res){ el.innerHTML='<div class="tit wait">Dati GENOVA non disponibili, o figura 7 non gestita dal metodo.</div>'; return; }
  verifica(res);
  const rim=COLPI-res.colpiGiocati;
  let stato;
  if(res.stato==="AMBO") stato=`<div class="ok">✔ AMBO VINCENTE al ${res.colpoMin}° colpo!</div>` + res.esiti.map(x=>`<div class="ok">${x}</div>`).join("");
  else if(rim>0) stato=`<div class="go">⏳ In gioco ► Colpo ${res.colpiGiocati+1} di ${COLPI} — ${"█".repeat(res.colpiGiocati)}${"░".repeat(rim)} — Rimasti: ${rim}</div>`;
  else stato=`<div class="ko">✖ SCADUTA — ${COLPI} colpi esauriti senza vincite</div>`;
  el.innerHTML=`
    <div class="tit">🍂 PREVISIONE ATTIVA ${anno}</div>
    <div class="info">Ultima Estr. Settembre GENOVA: ${res.data} | 2° GE: ${String(res.base).padStart(2,"0")} (Fig. ${res.fig})</div>
    <div class="num">AMBO: ${String(res.a1).padStart(2,"0")} - ${String(res.a2).padStart(2,"0")}</div>
    <div class="info">Ruote di gioco: GENOVA e MILANO (ambo secco) | Durata: ${COLPI} colpi | Recupero: TUTTE le ruote e NAZIONALE</div>
    ${stato}`;
  if(res.stato==="AMBO"){
    const k=res.data+"_"+res.colpoMin;
    if(localStorage.getItem("vincita")!==k){ localStorage.setItem("vincita",k);
      toast(`✔ AMBO VINCENTE!\n${res.str} al ${res.colpoMin}° colpo`); }
  }
}

/* ---------- storico ---------- */
function renderStorico(){
  const el=$("storico");
  if(!archivio.length){ el.innerHTML='<div class="card">Carica l\'archivio con "Aggiorna Internet"</div>'; return; }
  let html="", esaminati=0, vincenti=0, sommaColpi=0, secchi=0, tutte=0, naz=0;
  const Y=new Date().getFullYear();
  for(let anno=ANNO_INIZIO; anno<=Y; anno++){
    const dt=ultimaSett("GE",anno);
    if(!dt) continue;
    if(anno===Y && !settembreConcluso(anno)) continue;
    const res=calcola(dt,anno);
    if(!res) continue;
    verifica(res);

    let cls, righe;
    if(res.esiti.length){ cls="ok"; righe=res.esiti; }
    else if(res.colpiGiocati<COLPI){ cls="go"; righe=[`⏳ In gioco ► Colpo ${res.colpiGiocati+1} di ${COLPI} (Rimasti: ${COLPI-res.colpiGiocati})`]; }
    else { cls="ko"; righe=[`✖ NEGATIVO — ${COLPI} colpi esauriti`]; }

    if(res.stato!=="NEGATIVO" || res.colpiGiocati>=COLPI) esaminati++;
    if(res.stato!=="NEGATIVO" && res.colpiGiocati>0){ vincenti++; sommaColpi+=res.colpoMin; }
    for(const r of res.esiti){
      if(r.includes("Ambo secco")) secchi++;
      else if(r.includes("su TUTTE")) tutte++;
      else if(r.includes("su NAZIONALE")) naz++;
    }
    html = `<div class="card">
      <div class="riga"><span class="anno">Ottobre ${anno}</span><span class="amb ${cls}">${res.str}</span></div>
      <div class="meta">Ult. Sett GE: ${res.data} • 2° GE: ${res.base} • Fig. ${res.fig} • GE-MI</div>
      <div class="esiti">${righe.map(r=>`<div class="${cls}">${r}</div>`).join("")}</div>
    </div>` + html;   // più recente in alto
  }
  const perc = esaminati? Math.round(vincenti/esaminati*1000)/10 : 0;
  const medio = vincenti? Math.round(sommaColpi/vincenti*10)/10 : 0;
  html = `<div class="card tot">TOTALI<br>Anni esaminati: ${esaminati} | Vincenti: ${vincenti}<br>
    Ambi secchi GE/MI: ${secchi} | Su TUTTE: ${tutte} | Su NAZIONALE: ${naz}<br>
    Colpo medio: ${medio}° | Resa: ${perc>=100?"100% VINCENTE":perc+"%"}</div>` + html;
  el.innerHTML=html;
}

/* ---------- download archivio ---------- */
async function aggiorna(){
  const b=$("bAgg"); b.disabled=true; b.textContent="Download...";
  try{
    const r=await fetch(URL_GITHUB+"?t="+Date.now());
    if(!r.ok) throw new Error("HTTP "+r.status);
    const t=await r.text();
    const p=parse(t);
    if(!p.length) throw new Error("File non conforme");
    archivio=p;
    try{ localStorage.setItem("storico",t); }catch(e){}
    indicizza(); tutto();
    toast(`Archivio aggiornato!\nEstrazioni: ${dates.length}\nUltima: ${dates[dates.length-1]}`);
  }catch(e){
    toast("Errore download: "+e.message);
  }finally{
    b.disabled=false; b.textContent="⬇ Aggiorna Internet";
  }
}

function tutto(){ renderAttiva(); renderStorico(); }

$("bAgg").onclick=aggiorna;
$("bCalc").onclick=()=>{ tutto(); toast("Previsione ricalcolata"); };

/* ---------- avvio ---------- */
(function(){
  const salvato=localStorage.getItem("storico");
  if(salvato){ archivio=parse(salvato); indicizza(); }
  tutto();
  aggiorna(); // scarica subito l'archivio aggiornato
  setInterval(tutto, 60000);
})();
</script>
</body>
</html>
